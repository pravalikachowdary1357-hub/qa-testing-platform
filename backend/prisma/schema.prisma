}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EDITED_AND_ACCEPTED
}

enum ProductDocumentType {
  PRODUCT_REQUIREMENTS_BRD
  FUNCTIONAL_SPEC_FRD
  TECHNICAL_SPEC
  USER_MANUAL
  ARCHITECTURE_DESIGN
  API_DOCUMENTATION
  RELEASE_NOTES
  INSTALLATION_DEPLOYMENT_GUIDE
  CONFIGURATION_DOCUMENTS
  COMPLIANCE_REGULATORY
  REFERENCE_DOCUMENTS
  OTHER_SUPPORTING_FILES
}

enum ProductDocumentStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model Organization {
  id          String             @id @default(uuid())
  name        String             @unique
  // Optional short code, mirroring Product.productKey's exact convention
  // (nullable, unique, regex-validated at the DTO layer) -- not required
  // since the existing entity has shipped without one until now.
  orgKey      String?            @unique @map("org_key")
  description String?
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // Optional profile fields, all nullable since the entity has shipped
  // without them until now.
  orgReferenceId  String? @unique @map("org_reference_id")
  location        String?
  establishedYear Int?    @map("established_year")
  email           String?

  logoContent  Bytes?  @map("logo_content")
  logoMimeType String? @map("logo_mime_type")
  logoFileName String? @map("logo_file_name")
  logoFileSize Int?    @map("logo_file_size")

  products      Product[]
  projects      Project[]
  businessUnits BusinessUnit[]
  teams         Team[]
  users         User[]
  documents     OrganizationDocument[]

  @@map("organizations")
}

model OrganizationDocument {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  fileSize       Int      @map("file_size")
  content        Bytes
  uploadedBy     String   @map("uploaded_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_documents")
}

// Sits between Organization and Project per the QMICS TestSphere hierarchy
// (Organization -> Business Unit -> Project -> Product). businessUnitId on
// Project is nullable so every existing project keeps working unassigned --
// additive, not a forced migration of existing data, same pattern as
// Product.projectId.
model BusinessUnit {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  name           String
  description    String?
  status         OrganizationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projects     Project[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("business_units")
}

// Sits between Organization and Product per the QMICS TestSphere hierarchy.
// projectId on Product is nullable so every existing product keeps working
// unassigned -- this is additive, not a forced migration of existing data.
model Project {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  businessUnitId String?       @map("business_unit_id")
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  products     Product[]

  @@index([organizationId])
  @@index([businessUnitId])
  @@map("projects")
}

// A named group of users within an Organization (QA/dev/business "testing
// group"), independent of any single Product -- distinct from
// ProductTeamMember, which is a per-product membership roster, not a
// reusable cross-product Team entity.
model Team {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members      TeamMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id             String   @id @default(uuid())
  teamId         String   @map("team_id")
  userId         String   @map("user_id")
  responsibility String?
  createdAt      DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation("TeamMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Product {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id")
  projectId        String?          @map("project_id")
  name             String
  description      String
  status           ProductStatus    @default(ACTIVE)
  environment      String
  release          String
  productKey       String?          @map("product_key")
  applicationUrl   String?          @map("application_url")
  repositoryUrl    String?          @map("repository_url")
  productOwnerId   String?          @map("product_owner_id")
  currentVersion   String?          @map("current_version")
  testCoverage     Int              @map("test_coverage")
  passRate         Int              @map("pass_rate")
  openDefects      Int              @default(0) @map("open_defects")
  releaseReadiness ReleaseReadiness @default(NOT_READY) @map("release_readiness")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  productOwner     User?               @relation("ProductOwner", fields: [productOwnerId], references: [id], onDelete: SetNull)
  requirements     Requirement[]
  testPlans        TestPlan[]
  testScenarios    TestScenario[]
  environments     Environment[]
  defects          Defect[]
  apiTestRequests  ApiTestRequest[]
  performanceTests PerformanceTest[]
  securityTests    SecurityTest[]
  uatCycles        UatCycle[]
  releases         Release[]
  aiSuggestions    AiSuggestion[]
  documents        ProductDocument[]
  components       ProductComponent[]
  teamMembers      ProductTeamMember[]

  @@unique([organizationId, productKey])
  @@index([organizationId])
  @@index([projectId])
  @@index([productOwnerId])
  @@map("products")
}

model ProductComponent {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_components")
}

// Real users assigned to a product's testing team, with a free-text
// role-on-this-product label (distinct from the system-wide Role model --
// "Lead Tester on Product X" is not the same concept as an RBAC role).
model ProductTeamMember {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  userId         String   @map("user_id")
  responsibility String?
  createdAt      DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation("ProductTeamMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("product_team_members")
}

model ProductDocument {
  id             String                @id @default(uuid())
  productId      String                @map("product_id")
  documentType   ProductDocumentType   @map("document_type")
  fileName       String                @map("file_name")
  mimeType       String                @map("mime_type")
  fileSize       Int                   @map("file_size")
  content        Bytes
  version        Int                   @default(1)
  description    String?
  relatedVersion String?               @map("related_version")
  status         ProductDocumentStatus @default(DRAFT)
  uploadedBy     String                @map("uploaded_by")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  product  Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  versions ProductDocumentVersion[]

  @@index([productId])
  @@map("product_documents")
}

// Snapshot of a ProductDocument's content/metadata as of the moment it was
// superseded by a "Replace" upload -- created alongside (not instead of) the
// live update, so the current document row always reflects the latest file.
model ProductDocumentVersion {
  id             String                @id @default(uuid())
  documentId     String                @map("document_id")
  version        Int
  fileName       String                @map("file_name")
  mimeType       String                @map("mime_type")
  fileSize       Int                   @map("file_size")
  content        Bytes
  description    String?
  relatedVersion String?               @map("related_version")
  status         ProductDocumentStatus
  uploadedBy     String                @map("uploaded_by")
  createdAt      DateTime              @map("created_at")

  document ProductDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("product_document_versions")
}

model Requirement {
  id            String              @id @default(uuid())
  productId     String              @map("product_id")
  releaseId     String?             @map("release_id")
  title         String
  description   String
  type          RequirementType     @default(FUNCTIONAL)
  priority      RequirementPriority @default(MEDIUM)
  riskLevel     RequirementRisk     @default(MEDIUM) @map("risk_level")
  status        RequirementStatus   @default(DRAFT)
  ownerId       String?             @map("owner_id")
  // "1.0", bumped automatically by RequirementsService whenever a tracked
  // field changes -- never accepted as client input (see RequirementVersion).
  version       String              @default("1.0")
  reviewedById  String?             @map("reviewed_by_id")
  reviewedAt    DateTime?           @map("reviewed_at")
  reviewComment String?             @map("review_comment")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  product            Product                          @relation(fields: [productId], references: [id], onDelete: Restrict)
  release            Release?                         @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  owner              User?                            @relation("RequirementOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewedBy         User?                            @relation("RequirementReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  testPlans          TestPlan[]                       @relation("TestPlanRequirements")
  testScenarios      TestScenario[]
  uatTestCases       UatTestCase[]
  acceptanceCriteria RequirementAcceptanceCriterion[]
  attachments        RequirementAttachment[]
  versions           RequirementVersion[]

  @@index([productId])
  @@index([releaseId])
  @@index([ownerId])
  @@map("requirements")
}

// A single acceptance-criterion line under a Requirement. Fully replaced
// (delete-all-and-recreate) whenever the set changes, rather than diffed
// row-by-row -- the parent RequirementVersion entry records this as one
// "Acceptance Criteria updated" line, matching how the rest of this app
// tracks list-shaped fields.
model RequirementAcceptanceCriterion {
  id            String   @id @default(uuid())
  requirementId String   @map("requirement_id")
  text          String
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@map("requirement_acceptance_criteria")
}

// Deliberately simpler than ProductDocument: no document type/status/
// versioning, just a flat attached-file list with upload/download/remove.
model RequirementAttachment {
  id            String   @id @default(uuid())
  requirementId String   @map("requirement_id")
  fileName      String   @map("file_name")
  mimeType      String   @map("mime_type")
  fileSize      Int      @map("file_size")
  content       Bytes
  uploadedBy    String   @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@map("requirement_attachments")
}

// Append-only version history: one row per bump, written whenever a tracked
// field (title/description/type/priority/riskLevel/ownerId/releaseId/status/
// acceptanceCriteria) actually changes. Never deleted. `changes` is a
// JSON-stringified array of {field, previousValue, newValue}, matching
// AuditLog.metadata's string+manual-JSON convention rather than Prisma's
// Json type (unused elsewhere in this schema). `comment` carries a review
// decision's reason when this row was produced by an approve/reject/rework.
model RequirementVersion {
  id            String   @id @default(uuid())
  requirementId String   @map("requirement_id")
  version       String
  changedById   String?  @map("changed_by_id")
  changedAt     DateTime @default(now()) @map("changed_at")
  summary       String
  changes       String?
  comment       String?

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("RequirementVersionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([requirementId])
  @@map("requirement_versions")
}

model TestPlan {
  id          String           @id @default(uuid())
  productId   String           @map("product_id")
  releaseId   String?          @map("release_id")
  name        String
  description String
  status      TestPlanStatus   @default(DRAFT)
  priority    TestPlanPriority @default(MEDIUM)
  owner       String
  startDate   DateTime?        @map("start_date")
  endDate     DateTime?        @map("end_date")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  release      Release?      @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  requirements Requirement[] @relation("TestPlanRequirements")

  @@index([productId])
  @@index([releaseId])
  @@map("test_plans")
}

model TestScenario {
  id            String               @id @default(uuid())
  productId     String               @map("product_id")
  releaseId     String?              @map("release_id")
  requirementId String?              @map("requirement_id")
  title         String
  description   String
  type          TestScenarioType     @default(FUNCTIONAL)
  priority      TestScenarioPriority @default(MEDIUM)
  status        TestScenarioStatus   @default(DRAFT)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  release     Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  testCases   TestCase[]

  @@index([productId])
  @@index([releaseId])
  @@index([requirementId])
  @@map("test_scenarios")
}

model TestCase {
  id             String           @id @default(uuid())
  testScenarioId String           @map("test_scenario_id")
  releaseId      String?          @map("release_id")
  title          String
  description    String
  preconditions  String?
  expectedResult String           @map("expected_result")
  priority       TestCasePriority @default(MEDIUM)
  status         TestCaseStatus   @default(DRAFT)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  testScenario   TestScenario    @relation(fields: [testScenarioId], references: [id], onDelete: Restrict)
  release        Release?        @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  steps          TestCaseStep[]
  testData       TestData[]
  testExecutions TestExecution[]
  defects        Defect[]
  automations    Automation[]
  securityTests  SecurityTest[]

  @@index([testScenarioId])
  @@index([releaseId])
  @@map("test_cases")
}

model TestCaseStep {
  id             String @id @default(uuid())
  testCaseId     String @map("test_case_id")
  stepNumber     Int    @map("step_number")
  action         String
  expectedResult String @map("expected_result")

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("test_case_steps")
}

model TestData {
  id          String       @id @default(uuid())
  testCaseId  String?      @map("test_case_id")
  name        String
  description String?
  type        TestDataType @default(INPUT)
  value       String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  testCase       TestCase?       @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  testExecutions TestExecution[]

  @@index([testCaseId])
  @@map("test_data")
}

model Environment {
  id          String            @id @default(uuid())
  productId   String            @map("product_id")
  name        String
  type        EnvironmentType   @default(DEVELOPMENT)
  status      EnvironmentStatus @default(ACTIVE)
  baseUrl     String?           @map("base_url")
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  testExecutions   TestExecution[]
  defects          Defect[]
  automations      Automation[]
  apiTestRequests  ApiTestRequest[]
  performanceTests PerformanceTest[]
  securityTests    SecurityTest[]
  uatExecutions    UatExecution[]
  releases         Release[]

  @@unique([productId, name])
  @@index([productId])
  @@map("environments")
}

model TestExecution {
  id            String              @id @default(uuid())
  testCaseId    String              @map("test_case_id")
  environmentId String              @map("environment_id")
  testDataId    String?             @map("test_data_id")
  releaseId     String?             @map("release_id")
  status        TestExecutionStatus @default(PENDING)
  actualResult  String?             @map("actual_result")
  notes         String?
  executedBy    String              @map("executed_by")
  executedAt    DateTime            @default(now()) @map("executed_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  testCase    TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  testData    TestData?   @relation(fields: [testDataId], references: [id], onDelete: SetNull)
  release     Release?    @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  defects     Defect[]

  @@index([testCaseId])
  @@index([environmentId])
  @@index([testDataId])
  @@index([releaseId])
  @@map("test_executions")
}

model Defect {
  id               String         @id @default(uuid())
  productId        String         @map("product_id")
  environmentId    String?        @map("environment_id")
  testCaseId       String?        @map("test_case_id")
  testExecutionId  String?        @map("test_execution_id")
  releaseId        String?        @map("release_id")
  title            String
  description      String
  stepsToReproduce String         @map("steps_to_reproduce")
  expectedResult   String         @map("expected_result")
  actualResult     String         @map("actual_result")
  severity         DefectSeverity @default(MAJOR)
  priority         DefectPriority @default(MEDIUM)
  status           DefectStatus   @default(OPEN)
  assignedTo       String?        @map("assigned_to")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  environment   Environment?   @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  testCase      TestCase?      @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  testExecution TestExecution? @relation(fields: [testExecutionId], references: [id], onDelete: SetNull)
  release       Release?       @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  uatExecutions UatExecution[]

  @@index([productId])
  @@index([environmentId])
  @@index([testCaseId])
  @@index([testExecutionId])
  @@index([releaseId])
  @@map("defects")
}

model Automation {
  id            String              @id @default(uuid())
  testCaseId    String              @map("test_case_id")
  environmentId String?             @map("environment_id")
  releaseId     String?             @map("release_id")
  name          String
  type          AutomationType      @default(UI)
  framework     AutomationFramework @default(PLAYWRIGHT)
  description   String?
  schedule      String?
  enabled       Boolean             @default(true)
  lastRunStatus AutomationRunStatus @default(NOT_RUN) @map("last_run_status")
  lastRunAt     DateTime?           @map("last_run_at")
  lastRunNotes  String?             @map("last_run_notes")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  testCase    TestCase        @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  environment Environment?    @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  release     Release?        @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  runs        AutomationRun[]

  @@index([testCaseId])
  @@index([environmentId])
  @@index([releaseId])
  @@map("automations")
}

model AutomationRun {
  id           String              @id @default(uuid())
  automationId String              @map("automation_id")
  status       AutomationRunStatus
  startedAt    DateTime            @map("started_at")
  finishedAt   DateTime?           @map("finished_at")
  notes        String?
  recordedBy   String              @map("recorded_by")
  createdAt    DateTime            @default(now()) @map("created_at")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@map("automation_runs")
}

model ApiTestRequest {
  id             String      @id @default(uuid())
  productId      String      @map("product_id")
  environmentId  String?     @map("environment_id")
  releaseId      String?     @map("release_id")
  name           String
  method         HttpMethod  @default(GET)
  url            String
  headers        Json?
  queryParams    Json?       @map("query_params")
  body           String?
  authType       ApiAuthType @default(NONE) @map("auth_type")
  authConfig     Json?       @map("auth_config")
  expectedStatus Int?        @map("expected_status")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  environment Environment?       @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  release     Release?           @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  executions  ApiTestExecution[]

  @@index([productId])
  @@index([environmentId])
  @@index([releaseId])
  @@map("api_test_requests")
}

model ApiTestExecution {
  id              String   @id @default(uuid())
  apiRequestId    String   @map("api_request_id")
  statusCode      Int?     @map("status_code")
  responseTimeMs  Int?     @map("response_time_ms")
  responseHeaders Json?    @map("response_headers")
  responseBody    String?  @map("response_body")
  passed          Boolean?
  errorMessage    String?  @map("error_message")
  executedAt      DateTime @default(now()) @map("executed_at")

  apiRequest ApiTestRequest @relation(fields: [apiRequestId], references: [id], onDelete: Cascade)

  @@index([apiRequestId])
  @@map("api_test_executions")
}

model PerformanceTest {
  id                        String                @id @default(uuid())
  productId                 String                @map("product_id")
  environmentId             String?               @map("environment_id")
  releaseId                 String?               @map("release_id")
  name                      String
  description               String?
  targetUrl                 String                @map("target_url")
  method                    HttpMethod            @default(GET)
  headers                   Json?
  body                      String?
  virtualUsers              Int                   @map("virtual_users")
  rampUpSeconds             Int                   @map("ramp_up_seconds")
  durationSeconds           Int                   @map("duration_seconds")
  iterations                Int?
  thresholdResponseTimeMs   Int?                  @map("threshold_response_time_ms")
  thresholdErrorRatePercent Float?                @map("threshold_error_rate_percent")
  thresholdThroughputRps    Float?                @map("threshold_throughput_rps")
  lastRunStatus             PerformanceRunStatus? @map("last_run_status")
  lastRunAt                 DateTime?             @map("last_run_at")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")

  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  environment Environment?         @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  release     Release?             @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  runs        PerformanceTestRun[]

  @@index([productId])
  @@index([environmentId])
  @@index([releaseId])
  @@map("performance_tests")
}

model PerformanceTestRun {
  id                String               @id @default(uuid())
  performanceTestId String               @map("performance_test_id")
  status            PerformanceRunStatus
  startedAt         DateTime             @map("started_at")
  finishedAt        DateTime?            @map("finished_at")
  totalRequests     Int?                 @map("total_requests")
  failedRequests    Int?                 @map("failed_requests")
  avgResponseTimeMs Float?               @map("avg_response_time_ms")
  minResponseTimeMs Float?               @map("min_response_time_ms")
  maxResponseTimeMs Float?               @map("max_response_time_ms")
  p95ResponseTimeMs Float?               @map("p95_response_time_ms")
  throughputRps     Float?               @map("throughput_rps")
  errorRatePercent  Float?               @map("error_rate_percent")
  thresholdsPassed  Boolean?             @map("thresholds_passed")
  errorMessage      String?              @map("error_message")

  performanceTest PerformanceTest @relation(fields: [performanceTestId], references: [id], onDelete: Cascade)

  @@index([performanceTestId])
  @@map("performance_test_runs")
}

model SecurityTest {
  id             String             @id @default(uuid())
  productId      String             @map("product_id")
  environmentId  String?            @map("environment_id")
  testCaseId     String?            @map("test_case_id")
  releaseId      String?            @map("release_id")
  name           String
  description    String?
  target         String
  testType       SecurityTestType   @default(VULNERABILITY_SCAN) @map("test_type")
  configuration  String?
  status         SecurityTestStatus @default(NOT_STARTED)
  lastExecutedAt DateTime?          @map("last_executed_at")
  lastRunNotes   String?            @map("last_run_notes")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  environment Environment?      @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  testCase    TestCase?         @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  release     Release?          @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  findings    SecurityFinding[]

  @@index([productId])
  @@index([environmentId])
  @@index([testCaseId])
  @@index([releaseId])
  @@map("security_tests")
}

model SecurityFinding {
  id             String              @id @default(uuid())
  securityTestId String              @map("security_test_id")
  title          String
  description    String
  severity       FindingSeverity     @default(MEDIUM)
  evidence       String?
  recommendation String
  status         VulnerabilityStatus @default(OPEN)
  discoveredAt   DateTime            @default(now()) @map("discovered_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  securityTest SecurityTest @relation(fields: [securityTestId], references: [id], onDelete: Cascade)

  @@index([securityTestId])
  @@map("security_findings")
}

model UatCycle {
  id           String         @id @default(uuid())
  productId    String         @map("product_id")
  releaseId    String?        @map("release_id")
  name         String
  description  String?
  status       UatCycleStatus @default(PLANNED)
  signOffBy    String?        @map("sign_off_by")
  signOffAt    DateTime?      @map("sign_off_at")
  signOffNotes String?        @map("sign_off_notes")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  release   Release?      @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  testCases UatTestCase[]

  @@index([productId])
  @@index([releaseId])
  @@map("uat_cycles")
}

model UatTestCase {
  id             String   @id @default(uuid())
  uatCycleId     String   @map("uat_cycle_id")
  requirementId  String?  @map("requirement_id")
  title          String
  description    String?
  expectedResult String   @map("expected_result")
  assignedTester String   @map("assigned_tester")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  uatCycle    UatCycle          @relation(fields: [uatCycleId], references: [id], onDelete: Restrict)
  requirement Requirement?      @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  steps       UatTestCaseStep[]
  executions  UatExecution[]

  @@index([uatCycleId])
  @@index([requirementId])
  @@map("uat_test_cases")
}

model UatTestCaseStep {
  id             String @id @default(uuid())
  uatTestCaseId  String @map("uat_test_case_id")
  stepNumber     Int    @map("step_number")
  action         String
  expectedResult String @map("expected_result")

  uatTestCase UatTestCase @relation(fields: [uatTestCaseId], references: [id], onDelete: Cascade)

  @@index([uatTestCaseId])
  @@map("uat_test_case_steps")
}

model UatExecution {
  id            String             @id @default(uuid())
  uatTestCaseId String             @map("uat_test_case_id")
  environmentId String             @map("environment_id")
  defectId      String?            @map("defect_id")
  status        UatExecutionStatus @default(NOT_RUN)
  actualResult  String?            @map("actual_result")
  notes         String?
  evidence      String?
  executedBy    String             @map("executed_by")
  executedAt    DateTime           @default(now()) @map("executed_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  uatTestCase UatTestCase @relation(fields: [uatTestCaseId], references: [id], onDelete: Restrict)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  defect      Defect?     @relation(fields: [defectId], references: [id], onDelete: SetNull)

  @@index([uatTestCaseId])
  @@index([environmentId])
  @@index([defectId])
  @@map("uat_executions")
}

model Release {
  id            String        @id @default(uuid())
  productId     String        @map("product_id")
  environmentId String?       @map("environment_id")
  name          String
  version       String
  status        ReleaseStatus @default(PLANNED)
  releaseDate   DateTime?     @map("release_date")
  notes         String?
  signOffBy     String?       @map("sign_off_by")
  signOffAt     DateTime?     @map("sign_off_at")
  signOffNotes  String?       @map("sign_off_notes")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  environment Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  requirements     Requirement[]
  testPlans        TestPlan[]
  testScenarios    TestScenario[]
  testCases        TestCase[]
  testExecutions   TestExecution[]
  defects          Defect[]
  automations      Automation[]
  apiTestRequests  ApiTestRequest[]
  performanceTests PerformanceTest[]
  securityTests    SecurityTest[]
  uatCycles        UatCycle[]
  sprints          Sprint[]
  builds           Build[]

  @@index([productId])
  @@index([environmentId])
  @@map("releases")
}

// Foundation only, per the QMICS TestSphere Product Management spec:
// Release -> Sprint / Build (matches the spec's own "Release 2.5 -> Sprint
// 21/22/23" example). Both are pure children of a Release, so they cascade
// with it -- same relationship class as TestCaseStep -> TestCase.
model Sprint {
  id        String       @id @default(uuid())
  releaseId String       @map("release_id")
  name      String
  startDate DateTime?    @map("start_date")
  endDate   DateTime?    @map("end_date")
  status    SprintStatus @default(PLANNED)
  createdAt DateTime     @default(now()) @map("created_at")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@map("sprints")
}

model Build {
  id          String      @id @default(uuid())
  releaseId   String      @map("release_id")
  buildNumber String      @map("build_number")
  status      BuildStatus @default(PENDING)
  buildDate   DateTime?   @map("build_date")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@map("builds")
}

// Every AI-assisted suggestion this platform generates -- kept as a real,
// queryable audit trail (source context + the exact prompt/response) rather
// than an ephemeral client-side blob, so "prompt/input history" and "clear
// source used by each suggestion" are genuine, not simulated. Nothing here
// ever writes to a real entity by itself: accepting a suggestion is a
// separate, explicit call into that entity's own existing create/update
// endpoint, recorded back onto this row afterward.
model AiSuggestion {
  id         String             @id @default(uuid())
  capability AiCapability
  // Free-text tag naming the kind of source entity (e.g. "Requirement",
  // "TestScenario", "Defect", "Release") -- not an FK, since the source
  // entity type varies by capability and some capabilities have no single
  // source record (e.g. CHAT).
  sourceType String?            @map("source_type")
  sourceId   String?            @map("source_id")
  productId  String?            @map("product_id")
  prompt     String
  response   String
  status     AiSuggestionStatus @default(PENDING)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([capability])
  @@index([sourceType, sourceId])
  @@map("ai_suggestions")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// Roles and permissions are real, seeded, queryable data (not a hardcoded
// enum) so the Roles & Permissions matrix UI can list and edit them --
// permissions use a "resource:action" key convention (e.g. "users:manage").
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  // Protects a seeded role from deletion. No delete UI exists yet, but this
  // keeps the intent explicit at the schema level.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                        String     @id @default(uuid())
  email                     String     @unique
  passwordHash              String     @map("password_hash")
  name                      String
  status                    UserStatus @default(ACTIVE)
  roleId                    String     @map("role_id")
  // Nullable and not backfilled for existing users: a user with no
  // organization is treated as unscoped (sees across every organization,
  // matching today's behavior for everyone) -- organization-level data
  // isolation only starts applying once an admin explicitly assigns one.
  organizationId            String?    @map("organization_id")
  emailNotificationsEnabled Boolean    @default(true) @map("email_notifications_enabled")
  lastLoginAt               DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  role                      Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization              Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sessions                  Session[]
  auditLogs                 AuditLog[]           @relation("AuditLogActor")
  appSettingUpdates         AppSetting[]
  ownedProducts             Product[]            @relation("ProductOwner")
  productTeamMemberships    ProductTeamMember[]  @relation("ProductTeamMembership")
  teamMemberships           TeamMember[]         @relation("TeamMembership")
  requirementsOwned         Requirement[]        @relation("RequirementOwner")
  requirementReviews        Requirement[]        @relation("RequirementReviewedBy")
  requirementVersionChanges RequirementVersion[] @relation("RequirementVersionChangedBy")

  @@index([roleId])
  @@index([organizationId])
  @@map("users")
}

// Opaque, server-hashed session tokens persisted as real rows -- not
// stateless JWTs -- so logout/revocation is immediate and genuine, matching
// this codebase's preference for real audit-able data over ephemeral state.
model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  summary     String
  // Optional JSON string of non-sensitive before/after context. Never holds
  // passwords, tokens, or secrets.
  metadata    String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Singleton application-wide configuration row -- the service fetches (or
// lazily creates) the first row rather than relying on a fixed known id.
model AppSetting {
  id                             String           @id @default(uuid())
  defaultEnvironmentType         EnvironmentType? @map("default_environment_type")
  defaultTestCasePriority        TestCasePriority @default(MEDIUM) @map("default_test_case_priority")
  defaultDefectSeverity          DefectSeverity   @default(MAJOR) @map("default_defect_severity")
  notifyOnDefectCreated          Boolean          @default(true) @map("notify_on_defect_created")
  notifyOnReleaseReadinessChange Boolean          @default(true) @map("notify_on_release_readiness_change")
  notifyOnTestExecutionFailure   Boolean          @default(true) @map("notify_on_test_execution_failure")
  updatedAt                      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUserId                String?          @map("updated_by_user_id")

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("app_settings")
}
