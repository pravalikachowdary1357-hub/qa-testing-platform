// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  ACTIVE
  ON_HOLD
  DEPRECATED
}

enum ReleaseReadiness {
  READY
  CONDITIONAL
  NOT_READY
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum BuildStatus {
  PENDING
  PASSED
  FAILED
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
  BUSINESS
  TECHNICAL
}

enum RequirementPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  IMPLEMENTED
  VERIFIED
  REJECTED
}

enum RequirementRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestPlanStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TestPlanPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TestScenarioType {
  FUNCTIONAL
  REGRESSION
  INTEGRATION
  SMOKE
  EDGE_CASE
}

enum TestScenarioPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TestScenarioStatus {
  DRAFT
  READY
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TestCasePriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TestCaseStatus {
  DRAFT
  READY
  APPROVED
  DEPRECATED
}

enum TestDataType {
  INPUT
  EXPECTED_OUTPUT
  CREDENTIALS
  CONFIGURATION
  REFERENCE
}

enum EnvironmentType {
  DEVELOPMENT
  QA
  STAGING
  UAT
  PRODUCTION
}

enum EnvironmentStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TestExecutionStatus {
