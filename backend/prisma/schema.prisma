enum AiCapability {
  GENERATE_TEST_SCENARIOS
  GENERATE_TEST_CASES
  SUGGEST_TEST_DATA
  ANALYZE_EXECUTION
  SUMMARIZE_DEFECT
  SUGGEST_DEFECT_SEVERITY
  DUPLICATE_DEFECTS
  ANALYZE_COVERAGE
  EXPLAIN_RELEASE_RISKS
